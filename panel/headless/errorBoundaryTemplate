import { Component } from 'react'
import Error from './error.jsx'

export default class extends Component {
    state = { e: null }

    static getDerivedStateFromError(e) {
        const state = { e }
        return state
    }

    render() {
        return this.state.e
            ? <Error message={this.state.e.message} />
            : this.props.children
    }
}
