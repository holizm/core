#!/usr/bin/env bash

clear
latestVersion=$(npm view @openai/codex version) || exit "$?"
[[ -n "$latestVersion" ]] || exit 1
installedVersion=$(codex --version 2>/dev/null) || installedVersion=''

if [[ "$installedVersion" != "codex-cli $latestVersion" ]]; then
    sudo -i npm install -g @openai/codex@latest || exit "$?"
    hash -r
    installedVersion=$(codex --version) || exit "$?"
    [[ "$installedVersion" == "codex-cli $latestVersion" ]] || exit 1
fi

if [[ "$1" =~ ^[0-9]+$ ]]; then
    export CODEX_HOME="$HOME/.codex-account$1"
    mkdir -p "$CODEX_HOME"
    shift
fi

codex --dangerously-bypass-approvals-and-sandbox "$@"
