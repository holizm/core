#!/usr/bin/env node

import { spawnSync } from 'child_process'
import { randomInt } from 'crypto'
import {
    existsSync,
    readFileSync,
    readdirSync,
} from 'fs'
import os from 'os'
import path from 'path'
import fg from 'fast-glob'
import { clear } from '../scripts/terminal.js'

clear()

const home = os.homedir()
const directory = process.cwd()
const repositories = directory === home ? readdirSync(home, { withFileTypes: true })
    .filter(entry => !entry.name.startsWith('.') && !['docs', 'policies'].includes(entry.name) && entry.isDirectory() && existsSync(path.join(home, entry.name, '.git')))
    .map(entry => entry.name)
    : []

const patterns = directory === home ? repositories.map(repository => `${repository}/**/*`) : ['**/*']
const files = await fg(patterns, {
    absolute: true,
    cwd: directory,
    dot: false,
    followSymbolicLinks: false,
    ignore: [
        '**/.cache/**',
        '**/.git/**',
        '**/build/**',
        '**/coverage/**',
        '**/dist/**',
        '**/node_modules/**',
        '**/AGENTS.md',
        '**/*.mdx',
    ],
    onlyFiles: true,
})

while (files.length > 0) {
    const index = randomInt(files.length)
    const [file] = files.splice(index, 1)
    const content = readFileSync(file)
    if (content.includes(0)) {
        continue
    }
    console.log(file.replace(home, '~'))
    console.log('')
    process.stdout.write(content)
    if (content.length > 0 && content.at(-1) !== 10) {
        console.log('')
    }
    const result = spawnSync(path.join(home, 'core', 'commands', 'check'), [file, '--noClear'], { stdio: 'inherit' })
    if (result.error) throw result.error
    process.exit(result.status ?? 1)
}

console.error('No text files found in the current directory or its descendants.')
process.exit(1)
