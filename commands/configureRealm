#!/usr/bin/env node

import fs from 'fs'
import path from 'path'
import { lookup } from 'dns/promises'
import { getRealmConfiguration } from '../scripts/realmConfiguration.js'
import { createRealmKeycloak } from '../scripts/realmKeycloak.js'
import provisionRealm from '../scripts/provisionRealm.js'
import saveRealmSecrets from '../scripts/saveRealmSecrets.js'

const domain = process.argv[2]
if (!domain || !/^[a-z0-9.-]+$/.test(domain)) {
    throw new Error('Usage: configureRealm domain.tld')
}
const configuration = getRealmConfiguration(domain)
const origin = process.env.keycloakOrigin || `https://accounts.${domain}`
const common = JSON.parse(fs.readFileSync(path.join(process.env.HOME, 'secrets', 'common.json'), 'utf8'))
const addresses = await lookup(new URL(origin).hostname, { all: true })
const clientSecret = addresses.map(address => common.iam?.[address.address]).find(Boolean)
if (!clientSecret) throw new Error('Automation credential for the accounts server is missing')
const credentials = { clientSecret }
const request = await createRealmKeycloak(origin, credentials)
const clientSecrets = await provisionRealm(request, configuration)
saveRealmSecrets(configuration.secretPath, domain, clientSecrets)
console.log(`Configured Keycloak realm ${configuration.realm} and saved the local adminApi and site secrets`)
console.log('Server private settings still need these credentials for this domain')
