#!/usr/bin/env node

import isFile from '../../scripts/isFile.js'
import {
    clear,
} from '../../scripts/terminal.js'
import findSeedFiles from './findSeedFiles.js'
import run from './run'

const {
    apiRepo,
    home,
} = process.env

clear()

const files = findSeedFiles(process.cwd(), home)

let initialFile = `${home}/${apiRepo}/common/initial.js`
if (isFile(initialFile)) files.push(initialFile)
await run({
    app: 'query',
    command: 'insertData',
    files,
    show: true,
})
