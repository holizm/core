#!/usr/bin/env node

import { availableParallelism } from 'node:os'
import path from 'node:path'
import {
    startTimer,
    stopTimer
} from '../../scripts/timer.js'
import {
    divide,
    error,
    errorAndExit,
    info,
    warning,
} from '../../scripts/logger.js'
import {
    clear,
    runOnTerminal,
    runStreaming,
} from '../../scripts/terminal.js'
import {
    getLines,
    isFile,
} from '../../scripts/os.js'
import extract from '../../scripts/extract.js'
import run from './run'

const isDirectExecution =
    process.argv[1] &&
    path.resolve(process.argv[1]) === path.resolve(import.meta.filename)

if (isDirectExecution) {
    // clear()
}

const args = process.argv.slice(2)
let search = args[0] || ''
const { home } = process.env

const generateParts = async (parts, generatePart) => {
    let nextPartIndex = 0
    const workerCount = Math.min(availableParallelism(), parts.length)

    const generateNextPart = async () => {
        while (nextPartIndex < parts.length) {
            const partIndex = nextPartIndex
            nextPartIndex += 1
            await generatePart(parts[partIndex])
        }
    }

    await Promise.all(Array.from({ length: workerCount }, generateNextPart))
}

startTimer()

if (!search) {
    runOnTerminal('dropAll', { show: true })

    const {
        process: proc,
        repo,
    } = process.env

    const essentialPartsPath = `${home}/core/essentialParts`
    const partsPath = `${home}/${repo}/common/dependencies`
    const orderFile = `${home}/generation/order`
    const orderList = getLines(orderFile)
    const essentialParts = getLines(essentialPartsPath)
    const parts = getLines(partsPath)

    const set = Array.from(new Set([...essentialParts, ...parts]))

    const first = orderList.filter(x => set.includes(x))
    const second = set.filter(x => !orderList.includes(x))
    const finalList = [...first, ...second]

    const generatePart = async part => {
        const base = `${home}/${part}`
        const partFile = `${base}/part`

        if (!isFile(partFile)) {
            warning(`Did not find part file for ${partFile}`)
            return
        }

        info(`Generating ${part}`)
        await runStreaming(`generate ${part}`, {
            cwd: base,
        })
        info(`Generated ${part}`)
    }
    await generateParts(finalList, generatePart)

    // runOnTerminal('insertData', { show: true })
    stopTimer()
    process.exit(0)
}

search = search.replace('/', '')

const command = `
    find ${home} \
        -maxdepth 1 -mindepth 1 -type d \
        -name '*${search}*' \
        -exec test -f '{}/part' \\; \
        -print 2>/dev/null
`
const result = runOnTerminal(command)
const dirs = result.split('\n').filter(Boolean)
if (dirs.length > 1) {
    const generatePart = async dir => {
        const partFile = `${dir}/part`
        if (isFile(partFile)) {
            const part = path.basename(dir)
            info(`Generating ${part}`)
            await runStreaming(`generate ${part}`, {
                cwd: dir,
            })
            info(`Generated ${part}`)
        }
    }
    await generateParts(dirs, generatePart)
    stopTimer()
    process.exit(0)
}

if (dirs.length === 0) {
    errorAndExit(`No part is found for search ${search}`)
}

process.chdir(dirs[0])
divide()
const params = extract({
    container: true,
})
divide()
const partFile = `${home}/${params.repo}/part`

if (!isFile(partFile)) {
    warning(`Did not find ${partFile}`)
    stopTimer()
    process.exit(0)
}

await run({
    app: 'generation',
    part: params.repo,
    partPath: `${home}/${params.repo}`,
    show: true,
})

stopTimer()
