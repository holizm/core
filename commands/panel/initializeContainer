#!/usr/bin/env node

import {
    rmSync,
    writeFileSync,
} from 'fs'
import createControlPanelFiles from '../../scripts/createControlPanelFiles.js'
import isControlPanel from '../../scripts/isControlPanel.js'
import { info } from '../../scripts/logger.js'
import { runOnTerminal } from '../../scripts/terminal.js'

const {
    home,
    isCiCd,
    process: proc,
    processPath,
    repo,
} = process.env

const main = () => {
    rmSync('/tmp/panelReady', { force: true })
    rmSync('/tmp/panelInitializationFailed', { force: true })
    process.chdir(`${home}/${repo}/${proc}`)
    if (isControlPanel({
        process: proc,
        repo,
    })) {
        createControlPanelFiles(processPath)
    }
    runOnTerminal('merge panel', {
        show: true,
        throwOnError: true,
    })
    runOnTerminal('initialize', {
        show: true,
        throwOnError: true,
    })
    if (isCiCd !== 'true') {
        try {
            runOnTerminal('install', {
                show: true,
                throwOnError: true,
            })
        }
        catch (e) {
            writeFileSync('/tmp/panelInitializationFailed', '')
            info('Package installation failed. The container remains available; retry installPackages inside it.')
            return
        }
    }
    runOnTerminal('touch /tmp/panelReady', {
        show: true,
        throwOnError: true,
    })
}

try {
    main()
}
catch (e) {
    info(String(e))
    process.exitCode = 1
}
