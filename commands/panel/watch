#!/usr/bin/env bash

base=$home/$repo/$process

inotifywait -m -r \
    -e create \
    -e delete \
    -e delete_self \
    -e moved_from \
    -e moved_to \
    --exclude '/(\.agents|\.codex|\.git)(/|$)|/(exports\.jsx|admin\.jsx|common\.jsx)$' \
    --format '%w|%e|%f' \
    -q \
    "$base/src" |
while IFS='|' read -r directory event file; do
    case "$file" in
        *.jsx)
            echo "$directory$file $event"
            node "$home/core/commands/panel/generateExports.js"
            ;;
    esac
done
