#!/usr/bin/env bash

clear
set -euo pipefail

processPath="$home/$repo/$process"
lockPath="$processPath/package-lock.json"
installedLockHashPath="$processPath/node_modules/.installedLockHash"
installedPackageHashPath="$processPath/node_modules/.installedPackageHash"

if [[ ! -d "$processPath/node_modules" ]] || [[ ! -f "$lockPath" ]] || [[ "$(sha256sum "$lockPath" | cut -d' ' -f1)" != "$(cat "$installedLockHashPath" 2>/dev/null)" ]] || [[ "$(sha256sum "$processPath/package.json" | cut -d' ' -f1)" != "$(cat "$installedPackageHashPath" 2>/dev/null)" ]]; then
    cd "$processPath"
    installPackages
fi
