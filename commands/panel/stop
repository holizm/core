#!/usr/bin/env node

import {
    divide,
    info,
} from '../../scripts/logger.js'
import {
    clear,
    runOnTerminal,
} from '../../scripts/terminal.js'

clear()

const {
    process: proc,
    repo,
} = process.env

divide()
info(`Stopping ~/${repo}/${proc} ...`)
divide()

runOnTerminal(`ps -ef | rg 'npm\|vite' | rg -v rg | awk '{print $2}' | xargs -r kill -9 >/dev/null 2>&1`)
runOnTerminal(`ps -ef | rg 'npm\|serve' | rg -v rg | awk '{print $2}' | xargs -r kill -9 >/dev/null 2>&1`)
runOnTerminal("pkill -9 -f 'vite'")
