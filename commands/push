#!/usr/bin/env node

import { availableParallelism } from 'os'
import readline from 'readline'
import {
    divide,
    info,
    success,
    warning,
} from '../scripts/logger.js'
import commitRepo from '../scripts/commitRepo.js'
import ensureGitConfig from '../scripts/ensureGitConfig.js'
import findRepos from '../scripts/findRepos.js'
import pushRepo from '../scripts/pushRepo.js'
import status from '../scripts/status.js'

const promptYesNo = async question => {
    const rl = readline.createInterface({
        input: process.stdin,
        output: process.stdout,
    })
    const answer = await new Promise(resolve =>
        rl.question(question, a => resolve(a.trim()))
    )
    rl.close()
    return answer.toLowerCase() === 'y'
}

const searches = (process.argv[2] || '')
    .split(',')
    .map(search => search.trim())
    .filter(Boolean)
const searchTerms = searches.length ? searches : ['']

ensureGitConfig()
divide()
info('Getting the current status ...')
divide()

const results = searchTerms
    .flatMap(search => status(search))
    .filter((result, index, allResults) => allResults.findIndex(item => item.repo === result.repo) === index)

divide()
warning('Still pushing? (y,n)')
const ok = await promptYesNo('')
if (!ok) process.exit(0)

const repos = searchTerms
    .flatMap(search => findRepos(search))
    .filter((repo, index, allRepos) => allRepos.indexOf(repo) === index)

const toPush = []
const failed = new Set()

for (const dir of repos) {
    try {
        if (commitRepo(dir)) toPush.push(dir)
    } catch (e) {
        failed.add(dir)
        warning(e.message)
    }
}

const ahead = results
    .filter(r => ['ahead', 'diverged'].includes(r.type))
    .map(r => r.repo)

const unique = [...new Set([...toPush, ...ahead])].filter(repo => !failed.has(repo))

divide()
info(`Pushing ${unique.length} repos in parallel`)
divide()

let nextRepo = 0
const worker = async () => {
    while (nextRepo < unique.length) {
        const repo = unique[nextRepo++]
        if (!await pushRepo(repo)) failed.add(repo)
    }
}
await Promise.all(Array.from({ length: Math.min(availableParallelism(), unique.length) }, worker))

divide()
if (failed.size) {
    warning(`Push failed for ${failed.size} repositories`)
    process.exitCode = 1
} else success('Pushed all')
divide()
