#!/usr/bin/env node

import {
    clear,
    runStreaming,
} from '../scripts/terminal.js'
import {
    divide,
    errorAndExit,
    info,
} from '../scripts/logger.js'
import build from '../scripts/build.js'
import extract from '../scripts/extract.js'
import getExistingBuild from '../scripts/getExistingBuild.js'
import getInstance from '../scripts/getInstance.js'
import getSiteContentSource from '../scripts/getSiteContentSource.js'
import getPublishCleanupCommand from '../scripts/getPublishCleanupCommand.js'
import getPublishedPackageInstallCommand from '../scripts/getPublishedPackageInstallCommand.js'
import initializePublishedSettingsOverride from '../scripts/initializePublishedSettingsOverride.js'
import isFile from '../scripts/isFile.js'
import resolvePublishDomain from '../scripts/resolvePublishDomain.js'
import runOnServer from '../scripts/runOnServer.js'
import startPublishedProcess from '../scripts/startPublishedProcess.js'
import validatePublishArtifact from '../scripts/validatePublishArtifact.js'

const providedDomain = process.argv[2]

clear()

divide()
info('holism publish')
divide()

const publishParameters = extract()
const domain = providedDomain || resolvePublishDomain(publishParameters.repo)
const params =
    process.env.publishWithoutBuild === 'true'
        ?
        getExistingBuild(publishParameters)
        :
        await build({
            isCiCd: false,
            localBuild: true,
        })

const {
    isPanel,
    isSite,
    processBuildDir,
    repo,
} = params
const artifactPath = `${processBuildDir}/${params.process}.zip`
if (!isFile(artifactPath)) {
    errorAndExit(`Build artifact does not exist: ${artifactPath}`)
}
const contentRepository = isSite ? getSiteContentSource(params)?.repository : null
validatePublishArtifact(artifactPath, contentRepository)
const instance = await getInstance(domain, publishParameters.repo)
const remoteBuildDir = `/tmp/${repo}/${params.process}`
const remoteProcessPath = `$HOME/${instance?.serverDirectory}/${params.process}`

await runOnServer(domain, `rm -rf ${remoteBuildDir} && mkdir -p ${remoteBuildDir} ${remoteProcessPath}`)

divide()
info('Copying to the server...')
divide()

await runStreaming(`serverCopy ${artifactPath} ${domain}:${remoteBuildDir}/${params.process}.zip`)
if (!params.isApi) {
    await initializePublishedSettingsOverride({
        domain,
        remoteBuildDir,
        remoteProcessPath,
        settingsOverridePath: params.settingsOverridePath,
    })
}

divide()

await runOnServer(domain, getPublishCleanupCommand(remoteProcessPath, isPanel))
await runOnServer(domain, `unzip -o ${remoteBuildDir}/${params.process}.zip -d ${remoteProcessPath}`)
await runOnServer(domain, getPublishedPackageInstallCommand(params, remoteBuildDir, remoteProcessPath))

// if (isApi || isSite) {
//     try {
//         // --registry='https://mirror-npm.runflare.com'
//         await runOnServer(domain, `cd $HOME/${instance?.serverDirectory}/${params.process} && npm install --legacy-peer-deps`)
//     }
//     catch (e) {
//         divide()
//         info('Warning: npm install failed. Continuing deployment...')
//         error(e)
//         divide()
//     }
// }
await runOnServer(domain, `rm -rf ${remoteBuildDir}`)

await startPublishedProcess({
    domain,
    instance,
    params,
})

await runOnServer(domain, `/holism/server/commands/clearCache ${instance?.serverDirectory} ${params.process}`)

info('Done')
