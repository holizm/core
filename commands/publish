#!/usr/bin/env node

import {
    clear,
    runStreaming,
} from '../scripts/terminal.js'
import {
    divide,
    error,
    info,
} from '../scripts/logger.js'
import build from '../scripts/build.js'
import camelize from '../scripts/camelize.js'
import extract from '../scripts/extract.js'
import resolvePublishDomain from '../scripts/resolvePublishDomain.js'
import runOnServer from '../scripts/runOnServer.js'

const providedDomain = process.argv[2]

clear()

divide()
info('holism publish')
divide()

const publishParameters = extract()
const domain = providedDomain || resolvePublishDomain(publishParameters.repo)
const params = await build({
    isCiCd: false,
    localBuild: true,
})

const {
    isApi,
    isPanel,
    isSite,
    processBuildDir,
    repo,
} = params
const remoteBuildDir = `/tmp/${repo}/${params.process}`

await runOnServer(domain, `mkdir -p ${remoteBuildDir}`)

divide()
info('Copying to the server...')
divide()

await runStreaming(`serverCopy ${processBuildDir}/${params.process}.zip ${domain}:${remoteBuildDir}`)

divide()

await runOnServer(domain, `mv ${remoteBuildDir}/${params.process}.zip $HOME/${repo}/${params.process}`)
await runOnServer(domain, `cd $HOME/${repo}/${params.process} && unzip -o ${params.process}.zip`)
const user = (await runOnServer(domain, 'whoami', true)).trim()

if (isApi || isSite) {
    try {
        await runOnServer(domain, `cd $HOME/${repo}/${params.process} && npm install --registry='https://mirror-npm.runflare.com' --legacy-peer-deps`)
    }
    catch (e) {
        divide()
        info('Warning: npm install failed. Continuing deployment...')
        error(e)
        divide()
    }
}
if (isApi) {
    await runOnServer(domain, `unzip -o $HOME/${repo}/${params.process}/${params.process}.zip -d ${remoteBuildDir}`)
    await runOnServer(domain, `find ${remoteBuildDir} -type f -name exports.js -exec sed -i 's|/home/dev/|/home/${user}/|g' {} +`)
    await runOnServer(domain, `cp -R ${remoteBuildDir}/node_modules/* $HOME/${repo}/${params.process}/node_modules/`)
}

await runOnServer(domain, `rm -rf ${remoteBuildDir}`)

const fullProcessName = camelize(`${repo} ${params.process}`)

const port = (await runOnServer(
    domain,
    `grep -oP '127\\.0\\.0\\.1:\\K[0-9]+' $HOME/${repo}/${params.process}/compose.yaml | head -n1`,
    true
)).trim()

if (isApi) {
    await runOnServer(domain, `ln -s -f $HOME/${repo}/common/connectionStrings.json $HOME/${repo}/${params.process}/connectionStrings.json`)
    await runOnServer(domain, `ln -s -f $HOME/${repo}/common/publicSettings.json $HOME/${repo}/${params.process}/publicSettings.json`)
    await runOnServer(domain, `ln -s -f $HOME/${repo}/common/privateSettings.json $HOME/${repo}/${params.process}/privateSettings.json`)
    await runOnServer(domain, `cd $HOME/${repo}/${params.process} && /usr/local/node/bin/pm2 delete ${fullProcessName} || true && /usr/local/node/bin/pm2 start process.js --name ${fullProcessName} --update-env -- ${port}`)
}
else if (isPanel) {
    await runOnServer(domain, `cp -f $HOME/${repo}/common/publicSettings.json $HOME/${repo}/${params.process}/publicSettings.json`)
    await runOnServer(domain, `cp -f $HOME/${repo}/tenants $HOME/${repo}/${params.process}/tenants`)
    await runOnServer(domain, `cd $HOME/${repo}/${params.process} && /usr/local/node/bin/pm2 delete ${fullProcessName} || true && /usr/local/node/bin/pm2 start /usr/local/node/bin/serve --name ${fullProcessName} -- -s . -l ${port}`)
}
else if (isSite) {
    await runOnServer(domain, `ln -s -f $HOME/${repo}/tenants $HOME/${repo}/${params.process}/tenants`)
    await runOnServer(domain, `ln -s -f $HOME/${repo}/common/privateSettings.json $HOME/${repo}/${params.process}/privateSettings.json`)
    await runOnServer(domain, `ln -s -f $HOME/${repo}/common/publicSettings.json $HOME/${repo}/${params.process}/dist/publicSettings.json`)
    await runOnServer(domain, `ln -s -f $HOME/${repo}/${params.process}/settingsOverride.json $HOME/${repo}/${params.process}/dist/settingsOverride.json`)
    await runOnServer(domain, `cd $HOME/${repo}/${params.process} && /usr/local/node/bin/pm2 delete ${fullProcessName} || true && PORT=${port} /usr/local/node/bin/pm2 start server/entry.express.js --name ${fullProcessName}`)
}

info('Done')
