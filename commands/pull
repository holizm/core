#!/usr/bin/env node

import { execFile } from 'node:child_process'
import { promisify } from 'node:util'

import { runOnTerminal } from '../scripts/terminal.js'
import findChangedGithubRepos from '../scripts/findChangedGithubRepos.js'
import findRepos from '../scripts/findRepos.js'
import {
    divide,
    error,
    info,
    success,
    warning,
} from '../scripts/logger.js'
// import configVsCode from '../scripts/configVsCode.js'
// import adHoc from '../scripts/adHoc.js'

const search = process.argv[2]
const configuredTimeout = Number(process.env.vcsTimeout)
const timeoutSeconds = Number.isFinite(configuredTimeout) && configuredTimeout > 0
    ? configuredTimeout
    : 15
const configuredConcurrency = Number(process.env.vcsConcurrency)
const concurrency = Number.isInteger(configuredConcurrency) && configuredConcurrency > 0
    ? configuredConcurrency
    : 5
const execFileAsync = promisify(execFile)

divide()
info('Pulling repos ...')
divide()

const pullOnce = async dir => {
    try {
        const {
            stderr,
            stdout,
        } = await execFileAsync('git', ['-C', dir, 'pull'], {
            maxBuffer: 1024 * 1024 * 20,
            timeout: timeoutSeconds * 1000,
        })
        const result = {
            ok: true,
            out: `${stdout}${stderr}`.trim(),
            retryable: false,
        }
        return result
    } catch (e) {
        const out = `${e.stdout || ''}${e.stderr || e.message || ''}`.trim()
        const result = {
            ok: false,
            out,
            retryable: e.killed || /unexpected disconnect/i.test(out),
        }
        return result
    }
}

const pullWithRetry = async parent => {
    let result = await pullOnce(parent)
    let retries = 0

    while (!result.ok && result.retryable && retries < 5) {
        warning(`Retrying ${parent} (Attempt ${retries + 1}/5)`)
        result = await pullOnce(parent)
        retries++
    }

    if (result.ok) {
        success(parent)
        return true
    }

    error(`Pull failed for ${parent}`)
    error(`Message: ${result.out}`)
    return false
}

const repos = findRepos(search)
let reposToPull = repos

try {
    const {
        changed,
        unchecked,
    } = await findChangedGithubRepos(repos, timeoutSeconds * 1000)
    reposToPull = [...changed, ...unchecked]
    info(`Skipping ${repos.length - reposToPull.length} unchanged repos`)
} catch (e) {
    warning(`Batch check failed: ${e.message}`)
    warning('Falling back to pulling all matching repos')
}

let nextRepo = 0
const results = []
const worker = async () => {
    while (nextRepo < reposToPull.length) {
        const repo = reposToPull[nextRepo]
        nextRepo++
        results.push(await pullWithRetry(repo))
    }
}

await Promise.all(Array.from(
    {
        length: Math.min(concurrency, reposToPull.length),
    },
    worker,
))
// for (const repo of repos) {
//     await pullWithRetry(repo)
// }

// for (let i = 0; i < repos.length; i += 3) {
//     const batch = repos.slice(i, i + 3);
//     const promises = batch.map(repo => pullWithRetry(repo));
//     await Promise.all(promises);
// }

divide()
if (results.every(Boolean)) {
    success('Got all')
} else {
    warning('Completed with pull failures')
}
divide()

runOnTerminal('configIde')
runOnTerminal('configAi')
