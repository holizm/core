#!/usr/bin/env bash

set -uo pipefail

. $HOME/core/scripts/logger.sh

echo
clear

divide
info "Holism import"
divide

domain=${1:-}
search=${2:-""}

if [[ -z "$domain" ]]; then
    error "domain is not provided"
    divide
    exit
fi

secretFile=""
for file in $HOME/secrets/*.json; do
    if jq -e --arg domain "$domain" '.deployment.instances and (.deployment.instances[] | select(.domain == $domain))' "$file" >/dev/null; then
        secretFile="$file"
        break
    fi
done

if [[ -z "$secretFile" ]]; then
    error "No matching secrets file found for $domain in $HOME/secrets"
    divide
    exit
fi

vcsRepo=$(jq -r --arg domain "$domain" '.deployment | select(.instances[].domain == $domain) | .vcsRepo' "$secretFile")
serverDirectory=$(jq -r --arg domain "$domain" '.deployment.instances[] | select(.domain == $domain) | .serverDirectory' "$secretFile")

if [[ -z "$vcsRepo" || "$vcsRepo" == "null" ]]; then
    error "vcsRepo not found for $domain"
    divide
    exit
fi
if [[ -z "$serverDirectory" || "$serverDirectory" == "null" ]]; then
    error "serverDirectory not found for $domain"
    divide
    exit
fi

targetContainer="${vcsRepo}Databases"

read -r sshPort sshUser sshIp < <(node ~/core/scripts/extractSshParameters.js "$domain")

tempDir=$(mktemp -d "/tmp/${domain}.databasesBackup.XXXXXX")
trap 'rm -rf "$tempDir"' EXIT

remoteDirectory="/home/$sshUser/$serverDirectory/backupDirectory/databases"
downloadConcurrency=4
downloadAttempts=3
downloadSemaphore="$tempDir/downloadSemaphore"
mkfifo "$downloadSemaphore"
exec {downloadSemaphoreDescriptor}<>"$downloadSemaphore"
rm "$downloadSemaphore"

for ((downloadSlot = 0; downloadSlot < downloadConcurrency; downloadSlot++)); do
    printf '.' >&$downloadSemaphoreDescriptor
done

if [[ -z "$search" ]]; then
    remotePattern='*.archive'
else
    remotePattern="*$search*.archive"
fi

mapfile -t archiveNames < <(
    ssh -p "$sshPort" "$sshUser@$sshIp" \
        "find '$remoteDirectory' -maxdepth 1 -type f -name '$remotePattern' -printf '%f\n' | LC_ALL=C sort"
)

if [[ ${#archiveNames[@]} -eq 0 ]]; then
    error "No database archives found for $domain"
    divide
    exit 1
fi

declare -A archiveDatabases
for archiveName in "${archiveNames[@]}"; do
    archiveDatabases["${archiveName%.archive}"]=true
done

dropDatabase() {
    local databaseName=$1

    docker exec "$targetContainer" mongosh --quiet \
        --username FaMHJGecNag5DKryCH9d \
        --password IC1joYMLZTT0fQMJ5qcz \
        --authenticationDatabase admin \
        --eval "void db.getSiblingDB('$databaseName').dropDatabase()"
    success "$databaseName dropped"
}

downloadArchive() {
    local archiveName=$1
    local archivePath=$2
    local downloadAttempt
    local downloadStatus=1

    read -r -n 1 <&$downloadSemaphoreDescriptor

    for ((downloadAttempt = 1; downloadAttempt <= downloadAttempts; downloadAttempt++)); do
        if serverCopy "$domain:$remoteDirectory/$archiveName" "$archivePath"; then
            downloadStatus=0
            break
        fi

        rm -f "$archivePath"
        warning "$archiveName download attempt $downloadAttempt failed"
        if ((downloadAttempt < downloadAttempts)); then
            sleep 2
        fi
    done

    printf '.' >&$downloadSemaphoreDescriptor
    return "$downloadStatus"
}

importDatabase() {
    local archiveName=$1
    local archivePath="$tempDir/$archiveName"
    local databaseName=${archiveName%.archive}

    downloadArchive "$archiveName" "$archivePath" || return 1
    success "$databaseName downloaded"

    dropDatabase "$databaseName" || return 1

    docker exec -i "$targetContainer" mongorestore \
        --username=FaMHJGecNag5DKryCH9d \
        --password=IC1joYMLZTT0fQMJ5qcz \
        --authenticationDatabase=admin \
        --archive \
        --drop \
        --quiet \
        --gzip < "$archivePath" || return 1

    success "$databaseName imported"
}

info "Importing parts ..."
divide

mapfile -t existingDatabases < <(
    docker exec "$targetContainer" mongosh \
        --quiet \
        --username FaMHJGecNag5DKryCH9d \
        --password IC1joYMLZTT0fQMJ5qcz \
        --authenticationDatabase admin \
        --eval "db.adminCommand({ listDatabases: 1 }).databases.map(d => d.name).join('\n')"
)

pids=()
jobNames=()

for archiveName in "${archiveNames[@]}"; do
    importDatabase "$archiveName" &
    pids+=("$!")
    jobNames+=("${archiveName%.archive}")
done

for databaseName in "${existingDatabases[@]}"; do
    if [[ "$databaseName" == "admin" || "$databaseName" == "local" || "$databaseName" == "config" ]]; then
        continue
    fi
    if [[ -n "$search" && "$databaseName" != *"$search"* ]]; then
        continue
    fi
    if [[ -n "${archiveDatabases[$databaseName]:-}" ]]; then
        continue
    fi

    dropDatabase "$databaseName" &
    pids+=("$!")
    jobNames+=("$databaseName")
done

hasFailures=false
for jobIndex in "${!pids[@]}"; do
    if ! wait "${pids[$jobIndex]}"; then
        error "${jobNames[$jobIndex]} import failed"
        hasFailures=true
    fi
done

if [[ "$hasFailures" == true ]]; then
    divide
    error "Import failed for $domain"
    divide
    exit 1
fi

divide
success "Import finished for $domain"
divide
