#!/usr/bin/env bash

clear
set -e

basePath="$HOME"
tempDir="/tmp/temp"
repos=("api" "panel" "site" "newSite" "core" "policies")

mkdir -p "$tempDir"
cd "$tempDir"

for repoName in "${repos[@]}"; do
    echo "---- Processing $repoName ----"

    if ! test -d "$basePath/$repoName"; then
        clone holizm "$repoName"
    fi

    if ! test -f "$basePath/$repoName/package.json"; then
        echo "Missing package.json in $basePath/$repoName" >&2
        exit 1
    fi

    rm -f package.json

    cp "$basePath/$repoName/package.json" .

    npx npm-check-updates -u || true

    cp package.json "$basePath/$repoName/package.json"

    cd "$basePath/$repoName"

    git add package.json

    if ! git diff --cached --quiet; then
        git commit -m "update dependencies"
        git push
    else
        echo "No changes to commit for $repoName"
    fi

    cd "$tempDir"

    echo "---- Done $repoName ----"
done

echo "All repos updated."
