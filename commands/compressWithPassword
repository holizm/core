#!/usr/bin/env bash
set -euo pipefail
umask 077

if (( $# > 1 )); then
    printf 'Usage: compressWithPassword [fileOrDirectory]\n' >&2
    exit 1
fi

if ! command -v 7z >/dev/null 2>&1; then
    printf 'Install 7zip through setup before using this command.\n' >&2
    exit 1
fi

sourcePath=$(realpath -e -- "${1:-$PWD}")
sourceDirectory=$(dirname -- "$sourcePath")
sourceName=$(basename -- "$sourcePath")
archivePath="$PWD/$sourceName.7z"
if [[ -e "$archivePath" || -L "$archivePath" ]]; then
    printf 'Archive already exists: %s\n' "$archivePath" >&2
    exit 1
fi
if [[ ! -f "$sourcePath" && ! -d "$sourcePath" || "$sourcePath" == / ]]; then
    printf 'Choose a regular file or directory other than the filesystem root.\n' >&2
    exit 1
fi
sourceEntry="./$sourceName"
if [[ -d "$sourcePath" ]]; then
    sourceDirectory="$sourcePath"
    sourceEntry='.'
fi
archiveRelativePath=$(realpath -m --relative-to="$sourceDirectory" -- "$archivePath")

read -rsp 'Password (use a long, unique password): ' password
printf '\n' >&2
read -rsp 'Confirm password: ' confirmation
printf '\n' >&2
if [[ -z "$password" || "$password" != "$confirmation" ]]; then
    printf 'Passwords must match and must not be empty.\n' >&2
    exit 1
fi

cd -- "$sourceDirectory"
printf '%s\n%s\n' "$password" "$password" | 7z a -t7z -mhe=on -mx=9 -mmt="$(nproc)" -p "-x!$archiveRelativePath" -- "$archivePath" "$sourceEntry"
