#!/usr/bin/env bash

clear
set -euo pipefail

# https://iran.chabokan.net/
# https://www.arvancloud.ir/fa/dev/linux-repository

homeDir=$(getent passwd "${SUDO_USER:-$USER}" | cut -d: -f6)
setupDev="$homeDir/core/setupDev"
scripts="$homeDir/core/scripts"

export homeDir
export setupDev
export scripts

. "$scripts/installer.sh"

gitEmail=$(git config --global --get user.email || true)
gitName=$(git config --global --get user.name || true)

if [[ -z "$gitEmail" ]]; then
    if ! read -rp 'Git email: ' gitEmail; then
        error 'Could not read Git email; continuing setup.'
        setupFailures=$((setupFailures + 1))
    fi
fi

if [[ -z "$gitName" ]]; then
    if ! read -rp 'Git name: ' gitName; then
        error 'Could not read Git name; continuing setup.'
        setupFailures=$((setupFailures + 1))
    fi
fi

export gitEmail
export gitName

info "running setup ..."

runSetupStep developmentSetup "$setupDev/setup"

runSetupStep installHooks node "$homeDir/core/hooks/installHooks.js"
runSetupStep installCommands node "$homeDir/core/commands/installCommands.js"
runSetupStep setVcsIgnores node "$homeDir/core/scripts/setVcsIgnores.js"
runSetupStep configGit node "$homeDir/core/commands/configGit"

runSetupStep configureHosts bash "$scripts/configureHosts.sh"

runSetupStep policyDependencies "$setupDev/policyDependencies"

runSetupStep configIde node "$homeDir/core/commands/configIde"
runSetupStep configAi node "$homeDir/core/commands/configAi"
runSetupStep configAgent node "$homeDir/core/commands/configAgent"
runSetupStep enforce node "$homeDir/core/commands/enforce"

if (( setupFailures > 0 )); then
    error 'Setup finished with errors.'
    exit 1
fi

success 'setup complete'
