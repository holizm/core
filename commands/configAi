#!/usr/bin/env node

import {
    getContent,
    writeFile,
} from '../scripts/os.js'
import {
    divide,
    info,
} from '../scripts/logger.js'

const home = process.env.HOME
const sourcePath = `${home}/core/agents`
const destinationPath = `${home}/.codex/AGENTS.md`

divide()
info('Configuring AI')
divide()

const { default: policies } = await import(`${home}/policies/loadPolicies.js`)
const explanations = policies.map(({ policy }) => `- ${policy.explanation}`).join('\n')

const content = [
    getContent(sourcePath).trimEnd(),
    `# Generated policies\n\n${explanations}`,
].join('\n\n')

writeFile(destinationPath, `${content}\n`)

info(`Applied ${destinationPath}`)
