#!/usr/bin/env node

import { readdirSync } from 'fs'
import {
    getContent,
    writeFile,
} from '../scripts/os.js'
import {
    divide,
    info,
} from '../scripts/logger.js'
import { clear } from '../scripts/terminal.js'

clear()

const home = process.env.HOME
const sourcePath = `${home}/core/agents`
const accountDirectories = [
    '.codex',
    ...readdirSync(home, { withFileTypes: true })
        .filter(entry => entry.isDirectory() && entry.name.startsWith('.codex') && entry.name !== '.codex')
        .map(entry => entry.name)
        .sort(),
]

divide()
info('Configuring AI')
divide()

const { default: policies } = await import(`${home}/policies/loadPolicies.js`)
const { default: renderAgentPolicies } = await import(`${home}/policies/renderAgentPolicies.js`)

const content = [
    getContent(sourcePath).trimEnd(),
    renderAgentPolicies(policies).trimEnd(),
].join('\n\n')

for (const directory of accountDirectories) {
    const destinationPath = `${home}/${directory}/AGENTS.md`
    writeFile(destinationPath, `${content}\n`)
    info(`Applied ${destinationPath}`)
}
