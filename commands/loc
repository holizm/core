#!/usr/bin/env node

import {
    availableParallelism,
    tmpdir,
} from 'os'
import path from 'path'
import findRepos from '../scripts/findRepos.js'
import getLineCountFiles from '../scripts/getLineCountFiles.js'
import {
    deleteFile,
    writeFile,
} from '../scripts/os.js'
import {
    clear,
    runStreaming,
} from '../scripts/terminal.js'

clear()

const files = await getLineCountFiles(findRepos())

if (!files.length) process.exit(0)

const list = path.join(tmpdir(), `lineCount${process.pid}`)
try {
    writeFile(list, files.join('\n'))
    const quotedList = `'${list.replaceAll("'", "'\\''")}'`
    await runStreaming(`cloc --processes=${availableParallelism()} --list-file=${quotedList}`)
}
finally {
    deleteFile(list)
}
