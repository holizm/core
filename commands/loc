#!/usr/bin/env node

import findRepos from '../scripts/findRepos.js'
import {
    clear,
    runStreaming,
} from '../scripts/terminal.js'

clear()

const gits = findRepos()

if (!gits.length) process.exit(0)

const dirs = gits.join(' ')
await runStreaming(`cloc --fullpath --exclude-dir=node_modules --not-match-d='(^|/)\\.[^/]+' --not-match-f='(^|/)AGENTS\\.md$' ${dirs}`)
