#!/usr/bin/env bash
set -euo pipefail

. "$HOME/core/scripts/logger.sh"

if [[ $# -ne 2 ]]; then
    errorAndExit 'Usage: deleteUser domain username'
fi

domain="$1"
username="$2"
serverPath='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'

"$HOME/core/commands/runOnServer" "$domain" /usr/bin/env "PATH=$serverPath" /holism/server/commands/deleteUser "$username"
