#!/usr/bin/env bash
set -euo pipefail

echo
homeDir=$(getent passwd "${SUDO_USER:-$USER}" | cut -d: -f6)
. "$homeDir/core/scripts/logger.sh"

clear

if ! sudo apt update -o APT::Update::Error-Mode=any; then
    warning 'Some repositories could not refresh. Continuing with available package indexes.'
fi
updateStatus=0
sudo apt full-upgrade -y --fix-missing || updateStatus=$?
if (( updateStatus != 0 )); then
    warning 'Some system updates failed. Continuing with the Compass update.'
fi
scripts="$homeDir/core/scripts" "$homeDir/core/setupDev/compass" update || updateStatus=$?
exit "$updateStatus"
