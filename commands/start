#!/usr/bin/env node

import { clear } from '../scripts/terminal.js'
import {
    divide,
    info,
} from '../scripts/logger.js'
import resolveSiteProcessDirectory from '../scripts/resolveSiteProcessDirectory.js'
import start from '../scripts/start.js'

process.chdir(resolveSiteProcessDirectory(process.cwd()))
clear()

divide()
info('holism start')
divide()
info(`directory: ${process.cwd()}`)
divide()

await start()
