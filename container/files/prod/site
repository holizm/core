FROM node:lts-trixie-slim

WORKDIR ${containerHome}/${repo}/${process}

COPY --chown=node:node ${repo}/${process}/package.json ./package.json
RUN npm install --ignore-scripts --omit=optional --legacy-peer-deps
COPY --chown=node:node ${repo}/${process}/dist ./dist
COPY --chown=node:node ${repo}/${process}/server ./server
COPY --chown=node:node ${repo}/${process}/content ./content

ENV NODE_ENV=production
EXPOSE 3000
USER node
CMD ["node", "server/entry.express.js"]
