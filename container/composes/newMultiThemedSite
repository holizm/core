services:
    site:
        image: nefcanto/site
        ${userLine}
        container_name: ${containerName}
        hostname: site
        ports:
            - "${deterministicPort}:${deterministicPort}"
        working_dir: ${containerHome}/${repo}/${process}
        environment:
            - home=${containerHome}
            - containerHome=${containerHome}
            ${mkcertEnvironment}
            - org=${org}
            - repo=${repo}
            - process=${process}
            - processPath=${containerHome}/${repo}/${process}
            - isCiCd=${isCiCd}
            - deterministicPort=${deterministicPort}
            - npm_config_legacy_peer_deps=true
            - authSecret=t69bu9H55yXKQfUfx8fN
            - iamClientSecret=M8k36kf3wtF8JcO1F5vtiwHqI20dLmjU
            - iamIssuer=https://accounts.holism.ir/realms/development
            - PROTOCOL_HEADER=x-forwarded-proto
            - HOST_HEADER=x-forwarded-host
        volumes:
            - /tmp/mre:/tmp/mre
            - ${home}/packages/newSite:${containerHome}/.npm
            - ${home}/core:${containerHome}/core
            - ${home}/policies:${containerHome}/policies
            - ${home}/newSite/:${containerHome}/newSite/
            - ${home}/newSite/eslintConfig.js:${containerHome}/${repo}/${process}/eslint.config.js
            - ${home}/newSite/prettierIgnore:${containerHome}/${repo}/${process}/.prettierignore
            - ${home}/newSite/prettierRuntimeConfiguration:${containerHome}/${repo}/${process}/.prettierrc
            - ${home}/newSite/adapters:${containerHome}/${repo}/${process}/adapters
            - ${home}/newSite/buildPolicies:${containerHome}/${repo}/${process}/buildPolicies
            - ${home}/newSite/core:${containerHome}/${repo}/${process}/src/core
            - ${home}/newSite/pageParts:${containerHome}/${repo}/${process}/src/coreParts
            - ${home}/newSite/getters:${containerHome}/${repo}/${process}/src/coreGetters
            - ${home}/newSite/loaders:${containerHome}/${repo}/${process}/src/coreLoaders
            - ${home}/newSite/functions:${containerHome}/${repo}/${process}/src/coreFunctions
            - ${home}/newSite/hooks:${containerHome}/${repo}/${process}/src/coreHooks
            - ${home}/newSite/contexts:${containerHome}/${repo}/${process}/src/coreContexts
            - ${home}/newSite/postcssConfig.js:${containerHome}/${repo}/${process}/postcss.config.js
            - ${home}/newSite/src/entryExpress.tsx:${containerHome}/${repo}/${process}/src/entry.express.tsx
            - ${home}/newSite/src/entryPreview.tsx:${containerHome}/${repo}/${process}/src/entry.preview.tsx
            - ${home}/newSite/src/entrySsr.tsx:${containerHome}/${repo}/${process}/src/entry.ssr.tsx
            - ${home}/newSite/styles/${globalCssFile}:${containerHome}/${repo}/${process}/src/global.css
            - ${home}/newSite/src/pluginCore.ts:${containerHome}/${repo}/${process}/src/routes/plugin@_core.ts
            - ${home}/newSite/src/root.jsx:${containerHome}/${repo}/${process}/src/root.tsx
            - ${home}/newSite/src/routerHead.jsx:${containerHome}/${repo}/${process}/src/router-head.jsx
            - ${home}/newSite/src/documentIcons.jsx:${containerHome}/${repo}/${process}/src/documentIcons.jsx
            - ${home}/newSite/src/documentMetadata.jsx:${containerHome}/${repo}/${process}/src/documentMetadata.jsx
            - ${home}/newSite/src/documentSchemaScripts.jsx:${containerHome}/${repo}/${process}/src/documentSchemaScripts.jsx
            - ${home}/newSite/src/documentTrackingScripts.jsx:${containerHome}/${repo}/${process}/src/documentTrackingScripts.jsx
            - ${home}/newSite/src/routes/serviceWorker.ts:${containerHome}/${repo}/${process}/src/routes/service-worker.ts
            - ${home}/newSite/src/routes/error:${containerHome}/${repo}/${process}/src/routes/error
            - ${home}/newSite/src/routes/createBlobs:${containerHome}/${repo}/${process}/src/routes/create-blobs
            - ${home}/newSite/coreTsConfig.json:${containerHome}/${repo}/${process}/coreTsConfig.json
            - ${home}/newSite/core.css:${containerHome}/${repo}/${process}/core.css
            - ${home}/newSite/styles:${containerHome}/${repo}/${process}/coreStyles
            - ${home}/newSite/richTextRendererCollector.js:${containerHome}/${repo}/${process}/richTextRendererCollector.js
            - ${home}/newSite/itemRendererCollector.js:${containerHome}/${repo}/${process}/itemRendererCollector.js
            - ${home}/newSite/paginationBehaviorCollector.js:${containerHome}/${repo}/${process}/paginationBehaviorCollector.js
            - ${home}/newSite/settingsCreator.js:${containerHome}/${repo}/${process}/settingsCreator.js
            - ${home}/newSite/classPrefixer.js:${containerHome}/${repo}/${process}/classPrefixer.js
            - ${home}/newSite/nullLayoutProvider.js:${containerHome}/${repo}/${process}/nullLayoutProvider.js
            - ${home}/newSite/emptyDashboardProvider.js:${containerHome}/${repo}/${process}/emptyDashboardProvider.js
            - ${home}/newSite/loaderProvider.js:${containerHome}/${repo}/${process}/loaderProvider.js
            - ${home}/newSite/telemetry.js:${containerHome}/${repo}/${process}/telemetry.js
            - ${home}/newSite/themeStylesPlugin.js:${containerHome}/${repo}/${process}/themeStylesPlugin.js
            - ${home}/newSite/viteConfig.js:${containerHome}/${repo}/${process}/viteConfig.js
            - ${home}/newSite/multiThemedViteConfig.js:${containerHome}/${repo}/${process}/vite.config.js
            - ${home}/newSite/scripts/scroll.js:${containerHome}/${repo}/${process}/public/scripts/scroll.js
            ${mkcertVolume}
            - ${home}/secrets/${repo}.json:${containerHome}/${repo}/${process}/public/secrets.json
            - /tmp/${repo}/${process}/ast:/tmp/${repo}/${process}/ast
            - /tmp/${repo}/${process}/analysis:/tmp/${repo}/${process}/analysis
            - /tmp/${repo}/${process}/uiParts.json:/tmp/${repo}/${process}/uiParts.json
            - /tmp/${repo}/${process}/webServerCache:${containerHome}/webServerCache
            ${stylesVolume}

            ${volumes}

        command: |
            bash -lc '
            export PATH=${containerHome}/core/commands/newSite:${containerHome}/core/commands:$PATH
            rm -f /tmp/siteReady
            merge site
            installPackages
            printf "\e[31m%s %s\e[0m\n" "https://localhost:${deterministicPort}"
            cd ${containerHome}/${repo}/${process}
            initialize
            barrels && touch /tmp/siteReady
            tail -f /dev/null
            '
        networks:
            - ${networkRepo}Network
        extra_hosts:
            - "host.docker.internal:host-gateway"
            ${localApiHosts}

networks:
    ${networkRepo}Network:
        external: true
