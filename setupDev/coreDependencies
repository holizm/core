#!/usr/bin/env bash
set -euo pipefail

logPath=$(mktemp)
trap 'rm -f "$logPath"' EXIT

if npm ci --prefix "$homeDir/core" 2>&1 | tee "$logPath"; then
    exit 0
else
    npmStatus=${PIPESTATUS[0]}
fi

if ! grep -qF 'npm error code EUSAGE' "$logPath" \
    || ! grep -qF 'package.json and package-lock.json are in sync' "$logPath"; then
    exit "$npmStatus"
fi

npm install --package-lock-only --ignore-scripts --prefix "$homeDir/core"
npm ci --prefix "$homeDir/core"
