#!/usr/bin/env bash
set -euo pipefail

if ! rm -rf "$homeDir/core/package-lock.json"; then
    printf 'Could not remove the core lock file; continuing setup.\n' >&2
fi

if ! npm install --legacy-peer-deps --package-lock=false --prefix "$homeDir/core"; then
    printf 'Core dependency installation failed; continuing setup.\n' >&2
fi
