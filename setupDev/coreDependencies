#!/usr/bin/env bash
set -euo pipefail

. "$scripts/logger.sh"

failed=0

if ! rm -rf "$homeDir/core/package-lock.json"; then
    error 'Could not remove the core lock file.'
    failed=1
fi

if ! npm install --legacy-peer-deps --package-lock=false --prefix "$homeDir/core"; then
    error 'Core dependency installation failed.'
    failed=1
fi

exit "$failed"
