#!/usr/bin/env bash
. "$scripts/installer.sh"

installNode() {
    sudo apt-get update -y
    sudo apt-get install -y curl ca-certificates gnupg jq
    curl -fsSL https://deb.nodesource.com/setup_lts.x | sudo -E bash -
    sudo apt-get install -y nodejs

    if ! grep -qxF 'export NODE_OPTIONS="--trace-deprecation"' "$homeDir/.bashrc"; then
        echo 'export NODE_OPTIONS="--trace-deprecation"' >> "$homeDir/.bashrc"
    fi
    export NODE_OPTIONS="--trace-deprecation"
}

getInstalledNodeVersion() {
    node --version 2>/dev/null || true
}

getLatestNodeLtsVersion() {
    curl -fsSL https://nodejs.org/dist/index.json \
        | jq -r '[.[] | select(.lts != false)][0].version'
}

ensureLatestLts node getInstalledNodeVersion getLatestNodeLtsVersion installNode
