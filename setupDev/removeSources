#!/usr/bin/env bash
set -euo pipefail
shopt -s nullglob

sources=(
    /etc/apt/sources.list.d/safeeyes-team-*.list
    /etc/apt/sources.list.d/safeeyes-team-*.sources
)
backupDirectory="/var/backups/setupApt/$(date +%Y%m%dT%H%M%S)"

for source in "${sources[@]}"; do
    [[ -f "$source" ]] || continue
    sudo mkdir -p "$backupDirectory"
    sudo mv "$source" "$backupDirectory/"
    printf 'Disabled %s; backup: %s\n' "$source" "$backupDirectory/$(basename "$source")"
done
