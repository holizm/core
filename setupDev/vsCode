#!/usr/bin/env bash

. "$scripts/installer.sh"

installVsCode() {
    downloadDirectory=$(mktemp -d) || return $?
    trap 'rm -rf -- "$downloadDirectory"' EXIT
    local candidate
    local repositoryBase=''
    for candidate in https://packages.microsoft.com https://pmc-geofence.trafficmanager.net; do
        if curl -fsSL --connect-timeout 10 --max-time 30 "$candidate/keys/microsoft.asc" -o "$downloadDirectory/key.asc" \
            && gpg --batch --yes --dearmor --output "$downloadDirectory/key.gpg" "$downloadDirectory/key.asc" \
            && curl -fsSL --connect-timeout 10 --max-time 30 "$candidate/repos/code/dists/stable/InRelease" -o "$downloadDirectory/InRelease"; then
            repositoryBase="$candidate"
            break
        fi
    done
    if [[ -z "$repositoryBase" ]]; then
        error 'Could not retrieve the VS Code signing key and repository index.'
        return 1
    fi
    cat > "$downloadDirectory/source" <<EOF
Types: deb
URIs: $repositoryBase/repos/code
Suites: stable
Components: main
Architectures: amd64 arm64 armhf
Signed-By: /usr/share/keyrings/microsoft.gpg
EOF
    sudo install -o root -g root -m 644 "$downloadDirectory/key.gpg" /usr/share/keyrings/microsoft.gpg || return $?
    sudo install -o root -g root -m 644 "$downloadDirectory/source" /etc/apt/sources.list.d/vscode.sources || return $?
    sudo rm -f /etc/apt/sources.list.d/vscode.list || return $?
    sudo apt-get -o APT::Update::Error-Mode=any update || return $?
    sudo apt-get install -y apt-transport-https code
}

install code installVsCode
