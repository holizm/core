#!/usr/bin/env bash
set -euo pipefail

cacheDirectory="$homeDir/.cache/mongodb-memory-server"
archivePath="$cacheDirectory/mongodb.tgz"
binaryPath="$cacheDirectory/mongod"
downloadArchive="$homeDir/Downloads/mongodb-linux-x86_64-ubuntu2204-7.0.14.tgz"
mkdir -p "$cacheDirectory"

if [ ! -x "$binaryPath" ]; then
    if [ -f "$downloadArchive" ]; then
        cp "$downloadArchive" "$archivePath"
    else
        if ! curl -fL --retry 5 \
            -o "$archivePath" \
            'https://fastdl.mongodb.org/linux/mongodb-linux-x86_64-ubuntu2204-7.0.14.tgz'; then
            echo 'MongoDB test server download failed; continuing setup.'
            exit 0
        fi
    fi
    temporaryDirectory=$(mktemp -d "$cacheDirectory/extract.XXXXXXXXXX")
    trap 'rm -rf "$temporaryDirectory"; rm -f "$archivePath"' EXIT
    if ! tar -xzf "$archivePath" -C "$temporaryDirectory" \
        --strip-components=2 mongodb-linux-x86_64-ubuntu2204-7.0.14/bin/mongod; then
        echo 'MongoDB test server extraction failed; continuing setup.'
        exit 0
    fi
    chmod +x "$temporaryDirectory/mongod"
    mv "$temporaryDirectory/mongod" "$binaryPath" || {
        echo 'MongoDB test server preparation failed; continuing setup.'
        exit 0
    }
fi
